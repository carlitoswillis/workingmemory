# Copy to .env.local (gitignored). Local single-user use needs NONE of these —
# `npm run dev` with no env vars is the normal local setup.

# Where SQLite files live (default ./data). The hosted deploy points this at a
# mounted volume, e.g. /data.
#DATA_DIR=./data

# Hosted portfolio demo: every visitor gets an ephemeral seeded board.
# (`npm run dev:demo` sets this for you locally.)
#DEMO_MODE=1

# Single-owner auth on the hosted instance (only meaningful with DEMO_MODE=1):
# a valid session for this secret routes to the real owner board at
# DATA_DIR/owner/wm.db instead of a demo board, and authenticates /api/export.
# Use a long random value: openssl rand -base64 32
#OWNER_SECRET=

# The scoped ops bearer for the read-only bridge: GET /api/context,
# GET+POST /api/review, POST /api/items. Unset = those endpoints don't exist.
#BRAIN_TOKEN=

# Which board those bridge endpoints mean by "the owner's board". Leave it unset
# and the board is resolved automatically (the oldest root board carrying the
# Today/Focus/Backlog columns — see lib/bridge.ts). Set it to a board id to pin
# the answer; an id that isn't the owner's is ignored with a warning.
#WM_OWNER_BOARD_ID=

# Which account is "the owner" for the same endpoints (default: owner).
#OWNER_USERNAME=owner

# ── Web Push (phone app, iOS 16.4+ home-screen installs and Android) ──────────
# Generate a keypair once: npx web-push generate-vapid-keys
# Unset = the push endpoints don't exist and Settings shows "not set up".
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# RFC 8292 contact for the push services — a mailto: or an https URL.
#VAPID_SUBJECT=mailto:you@example.com
